{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=gnu++20",
                "-O2",
                "-Wall",
                "-Wextra",
                "-Wshadow",
                "-Wconversion",
                "-fsanitize=address,undefined",
                "${file}",
                "-o",
                "${fileDirname}/a.out"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run C++",
            "type": "shell",
            "command": "${fileDirname}/a.out",
            "dependsOn": "Build C++",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=gnu++20",
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "-Wshadow",
                "-Wconversion",
                "${file}",
                "-o",
                "${fileDirname}/a.out"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}